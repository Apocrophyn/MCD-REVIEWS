# Optional. Credentials are normally set in the app's Settings screen, which
# stores them encrypted under .data/. These variables are a fallback for
# headless setups and are only used when no credential is saved in Settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PORT=8787
DATA_DIR=.data
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_RECEIPT=3
